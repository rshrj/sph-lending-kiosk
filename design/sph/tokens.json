{
  "$source": "https://sph.ethz.ch/assets/release/css/app.css?v=2.1.0 (extracted 2026-11-07)",
  "color": {
    "brand": {
      "ink":         { "value": "#242424", "css": "--black",                 "use": "all text, rules, button outlines; dark-mode page" },
      "paper":       { "value": "#FFFFFF", "css": "--white / body bg",       "use": "page background" },
      "purple":      { "value": "#C891FA", "css": "--primary / --purple",    "use": "header, intro bands, primary accent" },
      "purpleLight": { "value": "#E4C7FD", "css": "breadcrumb strip",        "use": "sub-header strip, soft tint" },
      "yellow":      { "value": "#FFD200", "css": "--secondary / --warning", "use": "announcement bands, highlight brush" },
      "green":       { "value": "#0FDF75", "css": "--success / --green",     "use": "card outlines, success state" },
      "cyan":        { "value": "#82DCE1", "css": "--info / --cyan",         "use": "info / location bands, avatar discs" },
      "orange":      { "value": "#FF8C46", "css": "--orange (= --pink)",     "use": "call-to-action strips" },
      "red":         { "value": "#FE0000", "css": "--danger / --red",        "use": "errors only" }
    },
    "neutral": {
      "surface2":  { "value": "#F7F7F7" },
      "grayLight": { "value": "#EBEBEB", "css": "--gray-light" },
      "textDim":   { "value": "#555555", "css": "form text" },
      "gray":      { "value": "#777777", "css": "--darker" }
    },
    "alpha": {
      "rule":    "rgba(36,36,36,0.80)",
      "border":  "rgba(36,36,36,0.25)",
      "overlay": "rgba(36,36,36,0.80)",
      "focusRing": "0 0 0 .2rem <accent> @ 0.25"
    },
    "contrastOnInk": { "purple": 6.6, "yellow": 10.7, "green": 8.7, "cyan": 9.8, "orange": 6.7, "red": 3.9, "white": 15.5 },
    "contrastOnWhite": { "purple": 2.4, "yellow": 1.5, "green": 1.8, "cyan": 1.6, "orange": 2.3, "red": 4.0, "#555": 7.5, "#777": 4.5 },
    "rule": "Text on an accent fill is always ink (#242424), never white."
  },
  "font": {
    "body":    { "family": "Proxima Nova", "files": ["fonts/ProximaNova-Regular.ttf", "fonts/ProximaNova-Bold.ttf"], "weights": [400, 700], "siteWeight": 500 },
    "display": { "family": "Alternate Gothic No2 Pro", "files": ["fonts/AlternateGothicNo2Pro-Regular.ttf"], "weights": [400], "transform": "uppercase" }
  },
  "type": {
    "site":  { "remPx": 10, "body": 24, "h1": 100, "h2": 80, "h3": 49, "h4": 32, "button": 17, "lineHeightBody": 1.25, "lineHeightHeading": 1.0,
               "trackingPx": { "h1": 1.2, "h2": 1.5, "h3": 1.1, "link": 0.8 }, "mobile": { "remPx": 6.75, "body": 17 } },
    "kiosk": { "display": 96, "h1": 48, "h2": 32, "h3": 26, "button": 20, "label": 17, "body": 18, "small": 14,
               "trackDisplay": 1.2, "trackLabel": 0.8 }
  },
  "shape": {
    "radius": 0,
    "radiusExceptions": "circles (avatars) only",
    "shadow": "none",
    "stroke": { "button": 3, "card": 3, "cardSite": 4.5, "rule": 2 },
    "skewDeg": -20,
    "skewShear": -0.36397
  },
  "space": { "gap": 16, "pad": 24, "cardPadding": "26 22 16 (site)", "cardGrid": "345px cells, 24px gap (site)", "touchMin": 56, "headerHeight": 64 },
  "motion": {
    "color": "150ms ease-in-out",
    "transform": "250ms ease-in-out",
    "reveal": "300ms ease",
    "linkPressScale": 1.15,
    "qml": { "fast": 150, "normal": 250, "slow": 400, "easing": "Easing.InOutQuad" }
  }
}
